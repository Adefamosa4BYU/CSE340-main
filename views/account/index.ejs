    <main class="account-main">
      <h1><%= title %></h1>

      <!-- Flash Messages -->
      <%- messages() %>
      
      <% if (errors) { %>
      <ul class="errors">
        <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
        <%  }) %>
      </ul>
      <% } %>

      <p>You're logged in</p>

    </main>



