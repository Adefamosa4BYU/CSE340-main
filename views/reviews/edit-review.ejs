<main class="reviews-section">
    <h2>Edit Your Review</h2>

<% if (errors) { %>
  <ul>
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<form action="/reviews/edit" method="post">
  <input type="hidden" name="review_id" value="<%= review.review_id %>">
  <input type="hidden" name="inv_id" value="<%= review.inv_id %>">


  <label>Rating (1-5)</label>
  <input type="number" name="rating" min="1" max="5"
         value="<%= review.rating %>" required>

  <label>Review</label>
  <textarea name="review_text" required><%= review.review_text %></textarea>

  <button type="submit">Update Review</button>
</form>

</main>